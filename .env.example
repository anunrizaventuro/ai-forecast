# Salin ke .env (dev) / .env.prod (build Docker). Vite meng-inline semua
# VITE_* saat build — mengubah nilai butuh build ulang, bukan restart.

# Sumber data dashboard: 'simulasi' (default, generator dummy tanpa backend)
# atau 'api' (data asli dari ai-forecast-be).
VITE_FORECAST_SOURCE=simulasi

# Base URL ai-forecast-be (tanpa trailing slash). Wajib bila sumber = 'api'.
VITE_SERVER_URL=http://127.0.0.1:8080

# Header X-Company-Slug — opsional, hanya dikirim bila diisi.
VITE_COMPANY_SLUG=

# Prefix aset statis (kosong = root).
VITE_ASSETS_DIR=

# Firebase (login Google modul core skeleton) — tidak dipakai selama auth
# dimatikan (CONFIG.auth.skip); biarkan kosong.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
